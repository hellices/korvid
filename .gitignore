# Handshake files the mcp-follow capture uses: the readiness signal the
# `mcp` scene publishes once its server is bound and its TUI has mounted,
# and the gate that then releases the client pane. Created and removed by
# docs/demo/mcp-follow.tape and docs/demo/demo.py, never committed.
.korvid-mcp-demo-go
.korvid-mcp-demo-ready

# The client pane's verdict on its own run, written by docs/demo/mcp_client.py
# and read by docs/demo/record-mcp-follow.sh once VHS has returned: VHS records
# a fixed window and cannot tell a complete story from a client that died in
# the middle of one. Recording side effects like the two above, never
# committed.
.korvid-mcp-demo-client-ok
.korvid-mcp-demo-client-failed

# The private tmux server the mcp-follow capture composes on. tmux's default
# socket carries every session the invoking user is already running, so a
# fixed session name there is a name the recording only hopes is free — and
# its teardown would then kill a developer's own work. Bound and removed by
# docs/demo/mcp-follow.tape and docs/demo/record-mcp-follow.sh, never
# committed.
.korvid-mcp-demo.tmux.sock
.korvid-mcp-demo.lock

# The unreviewed render docs/demo/mcp-follow.tape writes on every attempt,
# successful or not. VHS exits 0 whatever the recording did, so the tape may
# never write the published clip directly; docs/demo/record-mcp-follow.sh
# promotes this candidate onto docs/assets/scenes/mcp-follow-demo.mp4 only
# when the client pane certified its run, and removes it on every other path.
docs/assets/scenes/.mcp-follow-demo.candidate.mp4

# Human-reviewed Agent and relationship takes. VHS cannot report whether the
# typed story succeeded, so each tape writes scratch and the documented recipe
# promotes it only after a human has inspected the complete candidate.
docs/assets/scenes/.agent-demo.candidate.mp4
docs/assets/scenes/.relationship-demo.candidate.mp4
